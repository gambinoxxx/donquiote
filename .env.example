# Copy to .env.local and fill in. Never commit real values.

# Neon Postgres (server only)
# Pooled connection (host contains -pooler), used by the app and worker
DATABASE_URL=
# Direct connection, used by Prisma CLI for migrations and studio
DIRECT_URL=

# Comma-separated, lowercase emails allowed to use the app (no spaces)
ALLOWED_EMAILS=

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=

# OANDA v20 (worker and scripts only; never exposed to the browser)
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=
# practice or live
OANDA_ENV=

# Web push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Resend email
RESEND_API_KEY=
ALERT_FROM_EMAIL=

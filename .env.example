# Copy to .env.local and fill in. Never commit real values.

# Neon Postgres (server only)
# Pooled connection (host contains -pooler), used by the app and worker
DATABASE_URL=
# Direct connection, used by Prisma CLI for migrations and studio
DIRECT_URL=

# Comma-separated, lowercase emails allowed to use the app (no spaces)
ALLOWED_EMAILS=

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=

# OANDA v20 (worker and scripts only; never exposed to the browser)
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=
# practice or live
OANDA_ENV=

# Web push (VAPID). Generate with: npx web-push generate-vapid-keys
# The public key goes in both VAPID_PUBLIC_KEY and NEXT_PUBLIC_VAPID_PUBLIC_KEY.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# mailto:<your email> (or an https URL)
VAPID_SUBJECT=

# Resend email (worker only). Alerts go to every address in ALLOWED_EMAILS.
RESEND_API_KEY=
# onboarding@resend.dev until a domain is verified in Resend (then it can only
# send to your own Resend login email), afterwards alerts@<yourdomain>
EMAIL_FROM=

# Absolute app URL for links in alert emails (default http://localhost:3000)
APP_URL=

# News (worker only). Both optional.
# Finnhub market news (free key from finnhub.io). Without it the headline
# feed adapter is skipped; the Fed and White House feeds still run.
FINNHUB_API_KEY=
# Claude, only to classify headlines the keyword rules can't decide (title
# only, max 200 calls a day). Without it: keyword rules only.
ANTHROPIC_API_KEY=

# "Scanner stopped" alarm (app only): cron-job.org sends
# Authorization: Bearer <CRON_SECRET> to /api/cron/scanner-check.
# At least 32 characters, e.g. `openssl rand -hex 32`.
CRON_SECRET=

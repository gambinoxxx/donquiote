// DG Signals database schema. All DateTime values are UTC.
// Prices are Float; rounding to pair precision happens at display.

generator client {
  provider = "prisma-client"
  output   = "../lib/db/generated"
}

datasource db {
  provider = "postgresql"
}

enum Pair {
  EUR_USD
  GBP_USD
  USD_JPY
  USD_CAD
  USD_CHF
  XAU_USD
}

enum Timeframe {
  D
  H4
  M15
}

enum Direction {
  BUY
  SELL
}

enum AlertStatus {
  WATCHING
  READY
  EXPIRED
  TAKEN
  SKIPPED
}

/// PDH/PDL = previous day high/low, EQH/EQL = equal highs/lows,
/// ASH/ASL = Asian session high/low, H4H/H4L = last closed 4H high/low
enum SweepType {
  PDH
  PDL
  EQH
  EQL
  ASH
  ASL
  H4H
  H4L
}

/// MARKET = entry at the confirming close; LIMIT = waits for price to
/// return to the entry until entryValidUntil (gemini-fvg)
enum EntryType {
  MARKET
  LIMIT
}

/// Paper trade (forward test) outcome. OPEN until the resolver decides.
/// NOT_FILLED = a LIMIT entry price was never reached in time (0R; left
/// out of win rate and net R).
enum PaperStatus {
  OPEN
  WIN
  LOSS
  UNRESOLVED
  NOT_FILLED
}

/// Notification outbox state of an alert (Unit 10). PENDING is set in the
/// same transaction that makes a LIVE strategy's alert READY; the worker
/// then sends and records the outcome.
enum NotifyState {
  NONE
  PENDING
  SENT
  MERGED
  STALE
  FAILED
}

/// A journal entry is OPEN until DG logs how it closed.
enum JournalStatus {
  OPEN
  CLOSED
}

/// How a trade DG took closed. CUSTOM = he typed the USD amount (fees etc.).
enum JournalResult {
  WIN
  LOSS
  BREAKEVEN
  CUSTOM
}

/// Prop firm max drawdown: from the starting balance (STATIC) or from the
/// highest closed balance so far (TRAILING).
enum DrawdownType {
  STATIC
  TRAILING
}

/// Single row (id = 1), shared by both users.
model Settings {
  id                  Int      @id @default(1)
  accountSizeUsd      Float    @default(10000)
  /// Basis for overall drawdown
  startingBalanceUsd  Float    @default(10000)
  riskPct             Float    @default(0.5)
  rewardRatio         Float    @default(3)
  dailyLossLimitPct   Float    @default(3)
  maxDrawdownPct      Float    @default(10)
  warnDailyLossPct    Float    @default(1.5)
  stopDailyLossPct    Float    @default(2)
  warnOverallLossPct  Float    @default(5)
  maxTradesPerDay     Int      @default(2)
  stopBufferPips      Float    @default(3)
  watchExpiryMinutes  Int      @default(120)
  /// Candles on each side of a swing point
  swingStrength       Int      @default(2)
  equalTolerancePips  Float    @default(2)
  /// Paper trade time limit in market hours (×4 = M15 candles) before UNRESOLVED
  paperTimeoutHours   Int      @default(72)
  /// When the prop firm's trading day starts (risk guard "today")
  dayResetTz          String   @default("America/New_York")
  dayResetHour        Int      @default(17)
  drawdownType        DrawdownType @default(STATIC)
  pushEnabled         Boolean  @default(true)
  emailEnabled        Boolean  @default(true)
  watchingPushEnabled Boolean  @default(false)
  updatedAt           DateTime @updatedAt
}

model WatchlistPair {
  pair      Pair    @id
  enabled   Boolean
  sortOrder Int
}

model Alert {
  id           String      @id @default(cuid())
  /// Registered strategy id that produced this alert (lib/strategy/registry.ts)
  strategyId   String      @default("dg-v1")
  pair         Pair
  direction    Direction
  status       AlertStatus @default(WATCHING)
  /// Why the status changed, e.g. "lot size below 0.01"
  statusNote   String?
  /// pair + direction + sweep candle time; unique per strategy
  dedupeKey    String
  sweepType    SweepType
  sweepLevel   Float
  sweepExtreme Float
  sweepTime    DateTime
  bosLevel     Float?

  // Trade ticket, filled when READY
  entry      Float?
  stop       Float?
  target     Float?
  stopPips   Float?
  targetPips Float?
  lotSize    Float?
  riskPct    Float?
  riskUsd    Float?
  entryType       EntryType @default(MARKET)
  /// LIMIT only: the entry may fill on candles that close by this time
  entryValidUntil DateTime?

  createdAt  DateTime  @default(now())
  readyAt    DateTime?
  expiresAt  DateTime
  expiredAt  DateTime?
  decidedAt  DateTime?
  /// When the notification step finished with this alert (SENT, MERGED, …)
  notifiedAt DateTime?

  // Notification outbox (Unit 10)
  notifyState   NotifyState        @default(NONE)
  notifyGroupId String?
  notifyGroup   NotificationGroup? @relation(fields: [notifyGroupId], references: [id])

  // Paper trade (forward test), opened when the alert becomes READY with a
  // valid ticket. One alert = at most one paper trade. Never feeds the risk
  // guard or the journal.
  paperStatus    PaperStatus?
  /// Close time of the confirming candle (= readyAt)
  paperOpenedAt  DateTime?
  /// Close time of the candle that resolved the trade
  paperClosedAt  DateTime?
  paperExitPrice Float?
  paperResultR   Float?
  paperPnlUsd    Float?
  /// e.g. "stop and target in same candle"
  paperNote      String?

  journal JournalEntry?

  @@unique([strategyId, dedupeKey])
  @@index([status, createdAt])
  @@index([pair, createdAt])
  @@index([strategyId, createdAt])
  @@index([paperStatus])
  @@index([strategyId, paperStatus])
  @@index([notifyState])
}

/// One push + email per pair and direction: LIVE alerts on the same pair and
/// direction within 30 minutes join the first one's group instead of
/// notifying again.
model NotificationGroup {
  id           String    @id @default(cuid())
  pair         Pair
  direction    Direction
  /// The alert that created the group (and was sent)
  firstAlertId String
  /// Strategies whose alerts are in the group, in joining order
  strategyIds  String[]
  createdAt    DateTime  @default(now())
  pushSent     Int       @default(0)
  pushFailed   Int       @default(0)
  emailSent    Int       @default(0)
  emailFailed  Int       @default(0)

  alerts Alert[]

  @@index([pair, direction, createdAt])
}

/// A trade DG really took (Unit 14). The only input of the risk guard:
/// paper trades never feed it.
model JournalEntry {
  id         String         @id @default(cuid())
  /// The alert it came from; null for a trade logged by hand
  alertId    String?        @unique
  alert      Alert?         @relation(fields: [alertId], references: [id])
  strategyId String?
  pair       Pair
  direction  Direction
  entry      Float
  stop       Float
  target     Float
  lots       Float
  /// Money lost if the stop is hit
  riskUsd    Float
  openedAt   DateTime
  status     JournalStatus  @default(OPEN)
  result     JournalResult?
  /// pnlUsd ÷ riskUsd
  resultR    Float?
  pnlUsd     Float?
  closedAt   DateTime?
  note       String?
  /// Soft delete: deleted entries never count
  deletedAt  DateTime?
  /// Signed-in email
  createdBy  String

  @@index([status, openedAt])
  @@index([openedAt])
}

model Candle {
  pair      Pair
  timeframe Timeframe
  /// Candle open time, UTC
  time      DateTime
  open      Float
  high      Float
  low       Float
  close     Float

  @@id([pair, timeframe, time])
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  userEmail String
  userAgent String?
  createdAt DateTime @default(now())
  /// Last push this device accepted
  lastSuccessAt DateTime?
  /// Failures in a row; the subscription is deleted after 5
  failCount     Int       @default(0)
}

/// Single row (id = 1), written by the worker each cycle.
model WorkerHeartbeat {
  id            Int       @id @default(1)
  lastScanAt    DateTime?
  lastOkAt      DateTime?
  /// ok | degraded | error | unknown
  status        String    @default("unknown")
  message       String?
  /// Worker build/version string
  version       String?
  /// Last daily candle cleanup (first cycle after 00:00 UTC)
  lastCleanupAt DateTime?
}

/// Where each strategy has got to on each pair: open time of the last M15
/// candle processed. Lets the worker catch up after downtime, in order.
model ScanCursor {
  pair           Pair
  strategyId     String
  lastCandleTime DateTime
  updatedAt      DateTime @updatedAt

  @@id([pair, strategyId])
}

/// LIVE = notifies (one or more; at least one), TEST = runs silently for
/// comparison, OFF = not run.
enum StrategyMode {
  LIVE
  TEST
  OFF
}

/// One row per registered strategy id (lib/strategy/registry.ts).
model StrategyConfig {
  strategyId String       @id
  mode       StrategyMode
  updatedAt  DateTime     @updatedAt
}

/// Every save of Settings, the watchlist and strategy modes (Unit 13). The
/// snapshot is the full state after the save; restoring an old version is a
/// new save, so a restore can itself be undone.
model SettingsVersion {
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now())
  /// Signed-in email, or "system" for the first version
  createdBy      String
  /// { settings, watchlist, strategies } — see lib/settings/snapshot.ts
  snapshot       Json
  /// [{ field, from, to }] compared with the previous version
  changes        Json
  /// Set when this version restored an older one
  restoredFromId String?

  @@index([createdAt])
}
